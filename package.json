{
  "name": "naps2-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "CotrimScan — digitalização de documentos com NAPS2 WebScan",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "dist:win": "electron-builder --win nsis",
    "dist:linux": "electron-builder --linux AppImage deb"
  },
  "devDependencies": {
    "electron": "^42.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.local.naps2desktop",
    "productName": "CotrimScan",
    "files": [
      "src/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office"
    },
    "asarUnpack": [
      "node_modules/sharp/**/*",
      "node_modules/@img/**/*",
      "node_modules/detect-libc/**/*",
      "node_modules/semver/**/*",
      "src/mobile-image-*.cjs"
    ]
  },
  "dependencies": {
    "@signpdf/placeholder-pdf-lib": "^4.0.0",
    "@signpdf/signer-p12": "^4.0.0",
    "@signpdf/signpdf": "^4.0.0",
    "@techstark/opencv-js": "^5.0.0-release.1",
    "@tesseract.js-data/por": "^1.0.0",
    "node-forge": "^1.4.3",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5",
    "tesseract.js": "^7.0.0"
  }
}

{
  "name": "cotrimscan",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@12.1.0",
  "description": "CotrimScan — monorepo: interface web (apps/web) e aplicativo desktop Electron (apps/desktop)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --filter=@cotrimscan/web --filter=@cotrimscan/scan-share",
    "build": "turbo run build",
    "test": "turbo run test",
    "start": "turbo run start --filter=@cotrimscan/desktop",
    "dist:win": "turbo run dist:win --filter=@cotrimscan/desktop",
    "dist:linux": "turbo run dist:linux --filter=@cotrimscan/desktop"
  },
  "devDependencies": {
    "turbo": "^2.5.0"
  }
}

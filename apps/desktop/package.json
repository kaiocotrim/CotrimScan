{
  "name": "@cotrimscan/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "CotrimScan — digitalização de documentos com NAPS2 WebScan (Electron)",
  "main": "src/main.cjs",
  "scripts": {
    "build": "node scripts/copy-renderer.cjs",
    "start": "electron .",
    "test": "node --test",
    "dist:win": "node scripts/publish-scan-share.cjs && electron-builder --win nsis --publish never",
    "dist:linux": "electron-builder --linux AppImage deb"
  },
  "devDependencies": {
    "@cotrimscan/web": "*",
    "electron": "^42.0.0",
    "electron-builder": "^26.0.0"
  },
  "dependencies": {
    "@cotrimscan/scan-core": "*",
    "@signpdf/placeholder-pdf-lib": "^4.0.0",
    "@signpdf/signer-p12": "^4.0.0",
    "@signpdf/signpdf": "^4.0.0",
    "@techstark/opencv-js": "^5.0.0-release.1",
    "@tesseract.js-data/por": "^1.0.0",
    "jscanify": "^1.4.3",
    "node-forge": "^1.4.3",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5",
    "tesseract.js": "^7.0.0",
    "zxing-wasm": "^3.1.6"
  },
  "build": {
    "appId": "com.local.naps2desktop",
    "productName": "CotrimScan",
    "files": [
      "src/**/*",
      "renderer/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office"
    },
    "asarUnpack": [
      "node_modules/sharp/**/*",
      "node_modules/@img/**/*",
      "node_modules/detect-libc/**/*",
      "node_modules/semver/**/*",
      "src/mobile-image-*.cjs",
      "src/document*.cjs",
      "node_modules/tesseract.js/**/*",
      "node_modules/tesseract.js-core/**/*",
      "node_modules/@tesseract.js-data/**/*",
      "node_modules/zxing-wasm/**/*"
    ],
    "extraResources": [
      {
        "from": "scan-share-publish",
        "to": "scan-share",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../../.local/naps2-cli/App",
        "to": "naps2-cli",
        "filter": [
          "**/*"
        ]
      }
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "CotrimScan-Setup-${version}.${ext}"
    }
  }
}
